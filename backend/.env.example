# Database Connection (PostgreSQL)
DATABASE_URL=postgres://user:password@host:5432/ascend

# Server Ports & URLs
PORT=8000
AI_SERVICE_URL=http://127.0.0.1:8001

# Security
JWT_SECRET=replace-with-secure-production-random-secret
JWT_EXPIRATION_HOURS=24

# Storage
STORAGE_DIR=./storage/proofs
MAX_FILE_SIZE_BYTES=10485760
